  "functions": {
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/children.js": {
      "maxDuration": 15
    },
    "api/guest-chat.js": {
      "maxDuration": 60
    },
    "api/digest.js": {
      "maxDuration": 60
    },
    "api/admin-convs.js": {
      "maxDuration": 30
    },
    "api/extract-fp.js": {
      "maxDuration": 60
    },
    "api/generate-report.js": {
      "maxDuration": 60,
      "regions": ["iad1"]
    }
  },
  "crons": [
    {
      "path": "/api/digest?action=portrait_all",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/digest?action=patterns",
      "schedule": "0 19 * * 0"
    },
    {
      "path": "/api/digest?action=weekly",
      "schedule": "0 20 * * 0"
    },
    {
      "path": "/api/digest?action=analyze_convs",
      "schedule": "0 19 * * 1"
    }
  ]
}
