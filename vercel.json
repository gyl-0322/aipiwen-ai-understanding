{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)",                    "dest": "/api/$1" },
    { "src": "/js/(.*)",                     "dest": "/js/$1" },
    { "src": "/patterns/(.*)",               "dest": "/patterns/$1" },
    { "src": "/admin.html",                  "dest": "/admin.html" },
    { "src": "/homepage.html",               "dest": "/homepage.html" },
    { "src": "/behavior-input.html",         "dest": "/behavior-input.html" },
    { "src": "/light-report.html",           "dest": "/light-report.html" },
    { "src": "/full-report.html",            "dest": "/full-report.html" },
    { "src": "/fingerprint-v2-wizard.html",  "dest": "/fingerprint-v2-wizard.html" },
    { "src": "/child-chat.html",             "dest": "/child-chat.html" },
    { "src": "/chat",                        "dest": "/child-chat.html" },
    { "src": "/personality",                 "dest": "/personality.html" },
    { "src": "/personality.html",            "dest": "/personality.html" },
    { "src": "/",                            "dest": "/homepage.html" },
    { "src": "/(.*)",                        "dest": "/homepage.html" }
  ],
  "functions": {
    "api/wechat.js":     { "maxDuration": 10 },
    "api/myip.js":       { "maxDuration": 5 },
    "api/auth.js":       { "maxDuration": 10 },
    "api/children.js":   { "maxDuration": 15 },
    "api/guest-chat.js": { "maxDuration": 15 },
    "api/digest.js":     { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/digest?action=portrait_all", "schedule": "0 2 * * *"   },
    { "path": "/api/digest?action=patterns",     "schedule": "0 3 * * 0"   },
    { "path": "/api/digest?action=weekly",       "schedule": "0 4 * * 0"   }
  ]
}
