{
  "version": 2,
  "routes": [
    {
      "src": "/api/growth",
      "dest": "/api/track"
    },
    {
      "src": "/api/stats",
      "dest": "/api/admin-convs"
    },
    {
      "src": "/api/log-session",
      "dest": "/api/guest-chat"
    },
    {
      "src": "/api/wechat",
      "dest": "/api/auth"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/lib/(.*)",
      "dest": "/lib/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/patterns/(.*)",
      "dest": "/patterns/$1"
    },
    {
      "src": "/admin.html",
      "dest": "/admin.html"
    },
    {
      "src": "/admin-convs.html",
      "dest": "/admin-convs.html"
    },
    {
      "src": "/admin-convs",
      "dest": "/admin-convs.html"
    },
    {
      "src": "/homepage.html",
      "dest": "/homepage.html"
    },
    {
      "src": "/behavior-input.html",
      "headers": {
        "Location": "/child-chat.html"
      },
      "status": 301
    },
    {
      "src": "/light-report.html",
      "dest": "/light-report.html"
    },
    {
      "src": "/full-report.html",
      "dest": "/full-report.html"
    },
    {
      "src": "/fingerprint-v2-wizard.html",
      "dest": "/fingerprint-v2-wizard.html"
    },
    {
      "src": "/child-chat.html",
      "dest": "/child-chat.html"
    },
    {
      "src": "/chat",
      "dest": "/child-chat.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/privacy.html",
      "dest": "/privacy.html"
    },
    {
      "src": "/personality",
      "dest": "/personality.html"
    },
    {
      "src": "/personality.html",
      "dest": "/personality.html"
    },
    {
      "src": "/synthesis.html",
      "dest": "/synthesis.html"
    },
    {
      "src": "/synthesis",
      "dest": "/synthesis.html"
    },
    {
      "src": "/report-upload.html",
      "dest": "/report-upload.html"
    },
    {
      "src": "/report-upload",
      "dest": "/report-upload.html"
    },
    {
      "src": "/report-viewer.html",
      "dest": "/report-viewer.html"
    },
    {
      "src": "/report-viewer",
      "dest": "/report-viewer.html"
    },
    {
      "src": "/api/generate-report",
      "dest": "/api/generate-report.js"
    },
    {
      "src": "/practitioner.html",
      "dest": "/practitioner.html"
    },
    {
      "src": "/api/invite",
      "dest": "/api/invite.js"
    },
    {
      "src": "/api/report-store",
      "dest": "/api/report-store.js"
    },
    {
      "src": "/practitioner",
      "dest": "/practitioner.html"
    },
    {
      "src": "/",
      "dest": "/homepage.html"
    },
    {
      "src": "/(.*)",
      "dest": "/homepage.html"
    }
  ],
  "functions": {
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/children.js": {
      "maxDuration": 15
    },
    "api/guest-chat.js": {
      "maxDuration": 30
    },
    "api/synthesize.js": {
      "maxDuration": 30
    },
    "api/digest.js": {
      "maxDuration": 60
    },
    "api/knowledge.js": {
      "maxDuration": 15
    },
    "api/admin-convs.js": {
      "maxDuration": 30
    },
    "api/track.js": {
      "maxDuration": 15
    },
    "api/extract-fp.js": {
      "maxDuration": 60
    },
    "api/generate-report.js": {
      "maxDuration": 60
    },
    "api/invite.js": {
      "maxDuration": 10
    },
    "api/report-store.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/digest?action=portrait_all",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/digest?action=patterns",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/digest?action=weekly",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/digest?action=analyze_convs",
      "schedule": "0 3 * * 1"
    }
  ]
}
